
pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
    }

    environment {
        REPO_URL = 'https://github.com/ranaaalihaider/django-todo-cicd.git'
        TARGET_BRANCH = 'develop'
        IMAGE_NAME = 'todo'
    }

    stages {

        stage('Code Checkout') {
            steps {
                git branch: "${TARGET_BRANCH}",
                    url: "${REPO_URL}"

                sh '''
                    echo "Repository: django-todo-cicd"
                    echo "Remote URL:"
                    git remote get-url origin

                    echo "Current Git Branch:"
                    git branch -r --contains HEAD

                    echo "Workspace Files:"
                    ls -la
                '''
            }
        }

        stage('Build') {
            agent {
                docker {
                    image 'python:3.9-slim'
                    reuseNode true
                }
            }

            steps {
                sh '''
                    python --version
                    pip install django==3.2
                    python manage.py check
                '''
                echo 'Build completed successfully'
            }
        }

        stage('Test') {
            steps {
                sh '''
                    docker build -t todo-test .
                    docker run --rm todo-test python manage.py check
                '''
                echo 'Test stage completed successfully'
            }
        }

        stage('Deploy') {
            when {
                expression {
                    env.TARGET_BRANCH == 'develop'
                }
            }

            steps {
                sh '''
                    docker build -t $IMAGE_NAME .

                    # Remove previous lab containers
                    docker rm -f todo_container1 todo_container2 || true

                    # Start two containers
                    docker run -d \
                      --name todo_container1 \
                      -p 8000:8000 $IMAGE_NAME

                    docker run -d \
                      --name todo_container2 \
                      -p 8001:8000 $IMAGE_NAME

                    echo "Running containers:"
                    docker ps

                    sleep 5

                    docker inspect -f '{{.State.Running}}' todo_container1 | grep true
                    docker inspect -f '{{.State.Running}}' todo_container2 | grep true

                    curl -fsS http://localhost:8000/todos > /dev/null
                    curl -fsS http://localhost:8001/todos > /dev/null

                    echo "Both containers are running successfully"
                '''
            }

            post {
                always {
                    echo 'Stopping and removing deployed containers'

                    sh '''
                        docker rm -f todo_container1 todo_container2 || true
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline executed successfully'
        }

        failure {
            echo 'Pipeline execution failed'
        }

        always {
            echo 'Pipeline execution completed'
        }
    }
}
